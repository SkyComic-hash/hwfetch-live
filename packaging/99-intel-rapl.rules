# 99-intel-rapl.rules — allow non-root users in the 'power' (or 'wheel')
# group to read Intel & AMD RAPL / powercap energy counters (energy_uj)
# and AMD hwmon energy counters for hwfetch-live.
#
# Install:
#   sudo cp packaging/99-intel-rapl.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=powercap
#
# Grant ACLs for both groups (setfacl preferred); fall back to chgrp power
# + chmod g+r on systems without the acl package.
ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="*rapl:*", \
  RUN+="/bin/sh -c '/usr/bin/setfacl -m g:power:r,g:wheel:r /sys/class/powercap/*rapl:*/energy_uj 2>/dev/null || { /usr/bin/chgrp power /sys/class/powercap/*rapl:*/energy_uj 2>/dev/null; /usr/bin/chmod g+r /sys/class/powercap/*rapl:*/energy_uj 2>/dev/null; }'"

ACTION=="add", SUBSYSTEM=="hwmon", \
  RUN+="/bin/sh -c '/usr/bin/setfacl -m g:power:r,g:wheel:r /sys/class/hwmon/hwmon*/energy*_input 2>/dev/null || true'"
