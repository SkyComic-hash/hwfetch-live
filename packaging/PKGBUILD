# Maintainer: SkyComic-hash <skygamechunnal@gmail.com>
pkgname=hwfetch-live
pkgver=0.1.0
pkgrel=1
pkgdesc="Fastfetch-style hardware info with real-time power & telemetry TUI for hybrid-graphics laptops"
arch=('x86_64')
url="https://github.com/SkyComic-hash/hwfetch-live"
license=('MIT')
depends=('glibc')
makedepends=('python' 'python-pip')
provides=('hwfetch-live')
conflicts=('hwfetch-live')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m venv "$srcdir/_build_venv"
  "$srcdir/_build_venv/bin/pip" --quiet install . pyinstaller
  "$srcdir/_build_venv/bin/pyinstaller" --noconfirm --clean packaging/hwfetch-live.spec
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 dist/hwfetch-live "$pkgdir/usr/bin/hwfetch-live"
  install -Dm644 packaging/hwfetch-live.desktop "$pkgdir/usr/share/applications/hwfetch-live.desktop"
  install -Dm644 packaging/99-intel-rapl.rules "$pkgdir/usr/lib/udev/rules.d/99-intel-rapl.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
